# User service that starts Bench Log at boot. Install steps are in README.md.
[Unit]
Description=Bench Log repair tracker
After=network-online.target

[Service]
WorkingDirectory=%h/benchlog
ExecStart=%h/benchlog/.venv/bin/python app.py
Environment=BENCHLOG_PORT=8080
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
